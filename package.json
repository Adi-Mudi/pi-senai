{
  "name": "@adi-mudi/pi-senai",
  "version": "1.7.0",
  "description": "Senai — stage-gated agent orchestration extension for Pi — Plan → Implement → Document → Deliver",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-senai",
    "orchestration",
    "stage-gated",
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adi-Mudi/pi-senai.git"
  },
  "bugs": {
    "url": "https://github.com/Adi-Mudi/pi-senai/issues"
  },
  "homepage": "https://github.com/Adi-Mudi/pi-senai#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/pi-extension/src",
    "dist/index.js",
    "dist/index.d.ts",
    "skills",
    "resources",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "test": "npm run build && node --test $(find dist/pi-extension/test -name '*.test.js' -not -path '*/e2e/*')",
    "test:e2e": "RUN_E2E=1 node --test --test-force-exit --test-timeout=180000 dist/pi-extension/test/e2e/*.test.js",
    "test:e2e:update-snapshots": "RUN_E2E=1 UPDATE_SNAPSHOTS=1 node --test --test-force-exit --test-timeout=180000 dist/pi-extension/test/e2e/*.test.js",
    "test:e2e:tier2": "RUN_E2E=1 RUN_LLM_E2E=1 node --test --test-force-exit --test-timeout=300000 dist/pi-extension/test/e2e/2*.test.js"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-tui": "^0.73.1",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
