{
  "name": "pi-senai",
  "version": "0.1.0",
  "description": "Senai — stage-gated agent orchestration extension for Pi — Plan → Implement → Document → Deliver",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-senai",
    "orchestration",
    "stage-gated",
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-senai/pi-senai.git"
  },
  "bugs": {
    "url": "https://github.com/pi-senai/pi-senai/issues"
  },
  "homepage": "https://github.com/pi-senai/pi-senai#readme",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test $(find dist/pi-extension/test -name '*.test.js' -not -path '*/e2e/*')",
    "test:e2e": "RUN_E2E=1 node --test --test-force-exit --test-timeout=180000 dist/pi-extension/test/e2e/*.test.js",
    "test:e2e:update-snapshots": "RUN_E2E=1 UPDATE_SNAPSHOTS=1 node --test --test-force-exit --test-timeout=180000 dist/pi-extension/test/e2e/*.test.js",
    "test:e2e:tier2": "RUN_E2E=1 RUN_LLM_E2E=1 node --test --test-force-exit --test-timeout=300000 dist/pi-extension/test/e2e/2*.test.js"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-tui": "^0.73.1",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
